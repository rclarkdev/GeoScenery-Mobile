{
  "ConnectionStrings": {
    "DefaultConnection": "<set-in-Azure-App-Service-configuration>"
  },
  "Jwt": {
    "Issuer": "https://<your-api-domain>",
    "Audience": "GeoScenery.Client",
    "ExpirationHours": 8,
    "Key": "<set-as-an-App-Service-secret>"
  },
  "Authorization": {
    "BootstrapAdminUserId": "<set-after-creating-the-initial-account>"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://<your-production-client-domain>"
    ]
  },
  "ForwardedHeaders": {
    "Enabled": true
  },
  "Storage": {
    "Local": {
      "RootPath": "/home/GeoScenery/uploads"
    },
    "MaxUploadBytes": 5242880,
    "MaxDimensionPixels": 1600,
    "ProfileMaxDimensionPixels": 512
  },
  "EmailSettings": {
    "SmtpClient": "smtp.gmail.com",
    "SmtpPort": 587,
    "NetworkCredentials": {
      "Username": "<smtp-account-address>",
      "Password": "<set-as-an-App-Service-secret>"
    }
  },
  "Email": {
    "ClientResetUrl": "https://<your-production-client-domain>/auth/reset-password",
    "ClientVerificationUrl": "https://<your-production-client-domain>/auth/verify-email"
  }
}